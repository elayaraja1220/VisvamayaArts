# Copy to .env and adjust if the backend moves.
# NEXT_PUBLIC_ values are baked into the JavaScript at `npm run build`
# (they are public — never put secrets here). Rebuild after changing them.

# PHP (CodeIgniter) API used by the website
NEXT_PUBLIC_API_URL=https://vismayamarts.in/admin/vismayam_service

# Where product and appreciation images uploaded in the admin are served from
NEXT_PUBLIC_API_PUBLIC_PRODUCT_IMAGE_BASE_URL=https://vismayamarts.in/admin/assets/images/products/
NEXT_PUBLIC_API_APPRECTION_IMAGE_BASE_URL=https://vismayamarts.in/admin/assets/images/appreciations/
